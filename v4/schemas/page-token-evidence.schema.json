{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ALLPROTO/core-lm-cross-model-lab/v4/schemas/page-token-evidence.schema.json",
  "title": "Core LM blind multi-model v4 page token evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "attemptId",
    "modelKey",
    "corpusProject",
    "pageRevisionId",
    "pageSelectionIndex",
    "vocabSize",
    "first512TokenIds",
    "first512StreamSHA256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "corelm-crossmodel-livewiki-v4-page-token-evidence-v1"
    },
    "suiteId": {
      "const": "corelm-voidtoken-crossmodel-livewiki-v4-author-verified"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    },
    "modelKey": {
      "enum": [
        "gpt-neo-125m",
        "smollm2-360m",
        "tiny-starcoder-py"
      ]
    },
    "corpusProject": {
      "enum": [
        "de.wikipedia.org",
        "en.wikipedia.org",
        "fr.wikipedia.org"
      ]
    },
    "pageRevisionId": {
      "type": "integer",
      "minimum": 1
    },
    "pageSelectionIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "vocabSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967296
    },
    "first512TokenIds": {
      "type": "array",
      "minItems": 512,
      "maxItems": 512,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "first512StreamSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
