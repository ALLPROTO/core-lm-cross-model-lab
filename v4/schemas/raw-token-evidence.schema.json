{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ALLPROTO/core-lm-cross-model-lab/v4/schemas/raw-token-evidence.schema.json",
  "title": "Core LM blind multi-model v4 raw token evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "attemptId",
    "modelKey",
    "corpusProject",
    "pageRevisionId",
    "pageSelectionIndex",
    "predictionIndex",
    "targetTokenId",
    "baselineLossF32Bits",
    "candidateLossF32Bits",
    "baselineTop1TokenId",
    "candidateTop1TokenId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "corelm-crossmodel-livewiki-v4-raw-token-evidence-v1"
    },
    "suiteId": {
      "const": "corelm-voidtoken-crossmodel-livewiki-v4-author-verified"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    },
    "modelKey": {
      "enum": [
        "gpt-neo-125m",
        "smollm2-360m",
        "tiny-starcoder-py"
      ]
    },
    "corpusProject": {
      "enum": [
        "de.wikipedia.org",
        "en.wikipedia.org",
        "fr.wikipedia.org"
      ]
    },
    "pageRevisionId": {
      "type": "integer",
      "minimum": 1
    },
    "pageSelectionIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "predictionIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "targetTokenId": {
      "$ref": "#/$defs/tokenId"
    },
    "baselineLossF32Bits": {
      "$ref": "#/$defs/f32Bits"
    },
    "candidateLossF32Bits": {
      "$ref": "#/$defs/f32Bits"
    },
    "baselineTop1TokenId": {
      "$ref": "#/$defs/tokenId"
    },
    "candidateTop1TokenId": {
      "$ref": "#/$defs/tokenId"
    }
  },
  "$defs": {
    "tokenId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "f32Bits": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    }
  }
}
