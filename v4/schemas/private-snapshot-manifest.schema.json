{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ALLPROTO/core-lm-cross-model-lab/v4/schemas/private-snapshot-manifest.schema.json",
  "title": "Core LM blind multi-model v4 sealed private snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "status",
    "createdAt",
    "countsTowardScientificVerdict",
    "designSHA256",
    "snapshotRegistrationSHA256",
    "designPublicationReceiptSHA256",
    "snapshotPublicationReceiptSHA256",
    "signingPublicKeySHA256",
    "runtimeManifestSHA256",
    "modelAssetSourceManifestSHA256",
    "fullAssetReceiptSHA256",
    "corpusManifestSHA256",
    "freezeManifestSHA256",
    "githubGateReceiptSHA256",
    "transportCABundleSHA256",
    "offlineTrustBundleSHA256",
    "cosignBinarySHA256",
    "labCommit",
    "labTree",
    "codecCommit",
    "codecTree",
    "labSourceManifestSHA256",
    "codecSourceManifestSHA256",
    "files",
    "contentSHA256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "corelm-crossmodel-livewiki-v4-private-snapshot-manifest-v1"
    },
    "suiteId": {
      "const": "corelm-voidtoken-crossmodel-livewiki-v4-author-verified"
    },
    "status": {
      "const": "SEALED_BEFORE_ATTEMPT"
    },
    "createdAt": {
      "$ref": "#/$defs/utcSecond"
    },
    "countsTowardScientificVerdict": {
      "const": false
    },
    "designSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "snapshotRegistrationSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "designPublicationReceiptSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "snapshotPublicationReceiptSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "signingPublicKeySHA256": {
      "$ref": "#/$defs/sha256"
    },
    "runtimeManifestSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "modelAssetSourceManifestSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "fullAssetReceiptSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "corpusManifestSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "freezeManifestSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "githubGateReceiptSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "transportCABundleSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "offlineTrustBundleSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "cosignBinarySHA256": {
      "$ref": "#/$defs/sha256"
    },
    "labCommit": {
      "$ref": "#/$defs/gitObject"
    },
    "labTree": {
      "$ref": "#/$defs/gitObject"
    },
    "codecCommit": {
      "$ref": "#/$defs/gitObject"
    },
    "codecTree": {
      "$ref": "#/$defs/gitObject"
    },
    "labSourceManifestSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "codecSourceManifestSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "contentSHA256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "utcSecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "role": {
      "enum": [
        "asset-source-manifest",
        "codec-source-manifest",
        "codec-source",
        "corpus-manifest",
        "design-publication-receipt",
        "design-release-asset",
        "development-control-archive-asset",
        "development-control-archive-receipt",
        "development-control-artifact",
        "development-control-report",
        "eligible-corpus-record",
        "eligible-ledger",
        "freeze-manifest",
        "frozen-design",
        "frozen-snapshot-registration",
        "full-asset-manifest",
        "github-gate-receipt",
        "lab-source",
        "lab-source-manifest",
        "model-asset",
        "nist-certificate-chain",
        "nist-trust-manifest",
        "pinned-cosign-binary",
        "release-signing-public-key",
        "runtime-manifest",
        "snapshot-publication-receipt",
        "snapshot-release-asset",
        "transport-ca-bundle"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "$ref": "#/$defs/role"
        }
      }
    }
  }
}
