{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ALLPROTO/core-lm-cross-model-lab/blind_v1/schemas/container-evidence.schema.json",
  "title": "Core LM blind multi-model blind-v1 container evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "attemptId",
    "modelKey",
    "corpusProject",
    "pageRevisionId",
    "pageSelectionIndex",
    "layerIndex",
    "denseBF16Bytes",
    "containerBytes",
    "containerSHA256",
    "relativePath",
    "structuralReplay"
  ],
  "properties": {
    "schemaVersion": {
      "const": "corelm-blind-crossmodel-v1-container-evidence-v1"
    },
    "suiteId": {
      "const": "corelm-blind-crossmodel-v1"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^20260821T180000Z-[0-9a-f]{16}$"
    },
    "modelKey": {
      "enum": [
        "pythia-160m",
        "pythia-70m",
        "smollm-135m",
        "smollm-360m",
        "gpt2-124m",
        "distilgpt2-82m"
      ]
    },
    "corpusProject": {
      "enum": [
        "de.wikipedia.org",
        "en.wikipedia.org",
        "fr.wikipedia.org"
      ]
    },
    "pageRevisionId": {
      "type": "integer",
      "minimum": 1
    },
    "pageSelectionIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "layerIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "denseBF16Bytes": {
      "type": "integer",
      "minimum": 1
    },
    "containerBytes": {
      "type": "integer",
      "minimum": 1
    },
    "containerSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "structuralReplay": {
      "const": true
    }
  }
}
