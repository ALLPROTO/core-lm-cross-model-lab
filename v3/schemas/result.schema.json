{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ALLPROTO/core-lm-cross-model-lab/v3/schemas/result.schema.json",
  "title": "Core LM blind multi-model v3 recomputed scientific result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "attemptId",
    "selectionSHA256",
    "pulseVerificationSHA256",
    "cells",
    "modelAggregates",
    "suitePass",
    "countsTowardScientificVerdict"
  ],
  "properties": {
    "schemaVersion": {
      "const": "corelm-crossmodel-livewiki-v3-result-v1"
    },
    "suiteId": {
      "const": "corelm-voidtoken-crossmodel-livewiki-v3-author-verified"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    },
    "selectionSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "pulseVerificationSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "cells": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "modelAggregates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/modelAggregate"
      }
    },
    "suitePass": {
      "type": "boolean"
    },
    "countsTowardScientificVerdict": {
      "const": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modelKey": {
      "enum": [
        "gpt-neo-125m",
        "smollm2-360m",
        "tiny-starcoder-py"
      ]
    },
    "corpusProject": {
      "enum": [
        "de.wikipedia.org",
        "en.wikipedia.org",
        "fr.wikipedia.org"
      ]
    },
    "finiteNumber": {
      "type": "number"
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelKey",
        "corpusProject",
        "pages",
        "predictions",
        "denseBF16Bytes",
        "containerBytes",
        "compressionRatioVsBF16",
        "deltaNLLNatPerToken",
        "top1Agreement",
        "structuralReplay",
        "pass"
      ],
      "properties": {
        "modelKey": {
          "$ref": "#/$defs/modelKey"
        },
        "corpusProject": {
          "$ref": "#/$defs/corpusProject"
        },
        "pages": {
          "const": 16
        },
        "predictions": {
          "const": 2048
        },
        "denseBF16Bytes": {
          "type": "integer",
          "minimum": 1
        },
        "containerBytes": {
          "type": "integer",
          "minimum": 1
        },
        "compressionRatioVsBF16": {
          "$ref": "#/$defs/finiteNumber"
        },
        "deltaNLLNatPerToken": {
          "$ref": "#/$defs/finiteNumber"
        },
        "top1Agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "structuralReplay": {
          "const": true
        },
        "pass": {
          "type": "boolean"
        }
      }
    },
    "modelAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelKey",
        "pages",
        "predictions",
        "deltaUpper",
        "top1Lower",
        "wilsonLower",
        "pass"
      ],
      "properties": {
        "modelKey": {
          "$ref": "#/$defs/modelKey"
        },
        "pages": {
          "const": 32
        },
        "predictions": {
          "const": 4096
        },
        "deltaUpper": {
          "$ref": "#/$defs/finiteNumber"
        },
        "top1Lower": {
          "$ref": "#/$defs/finiteNumber"
        },
        "wilsonLower": {
          "$ref": "#/$defs/finiteNumber"
        },
        "pass": {
          "type": "boolean"
        }
      }
    }
  }
}
