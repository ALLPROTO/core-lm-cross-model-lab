    },
    "readyToFreeze": {
      "type": "boolean"
    },
    "countsTowardScientificVerdict": {
      "type": "boolean"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "scientificBoundary": {
      "type": "string",
      "minLength": 1
    },
    "developmentControls": {
      "$ref": "#/$defs/developmentControls"
    },
    "designRelease": {
      "$ref": "#/$defs/releasePlan"
    },
    "futureCorpus": {
      "$ref": "#/$defs/futureCorpus"
    },
    "snapshotRelease": {
      "$ref": "#/$defs/releasePlan"
    },
    "evidenceRelease": {
      "$ref": "#/$defs/releasePlan"
    },
    "closeoutRelease": {
      "$ref": "#/$defs/closeoutReleasePlan"
    },
    "reschedulePolicy": {
      "$ref": "#/$defs/reschedulePolicy"
    },
    "codecSource": {
      "$ref": "#/$defs/codecSource"
    },
    "labSource": {
      "$ref": "#/$defs/labSource"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "continuousIntegration": {
      "$ref": "#/$defs/continuousIntegration"
