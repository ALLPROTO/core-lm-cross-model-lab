      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "beacon": {
      "$ref": "#/$defs/beacon"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "cellGates": {
      "$ref": "#/$defs/cellGates"
    },
    "modelAggregateGates": {
      "$ref": "#/$defs/modelAggregateGates"
    },
    "oneShotStateMachine": {
      "$ref": "#/$defs/oneShotStateMachine"
    },
    "freezeBlockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "DRAFT_NOT_PREREGISTERED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "const": "corelm-crossmodel-livewiki-v3-design-draft-v1"
          },
          "readyToFreeze": {
            "const": false
          },
          "countsTowardScientificVerdict": {
            "const": false
          },
          "developmentControls": {
            "properties": {
              "realDataE2EFreezeGate": {
                "properties": {
                  "status": {"const": "UNBOUND_DRAFT"},
                  "executionId": {"type": "null"},
                  "archiveReceiptSHA256": {"type": "null"},
                  "archivePublishedAt": {"type": "null"},
                  "archiveAttestedAt": {"type": "null"},
                  "releaseAttestationBundleSHA256": {"type": "null"},
                  "releaseAttestationOutputSHA256": {"type": "null"},
                  "reportSHA256": {"type": "null"},
                  "artifactSetSHA256": {"type": "null"},
                  "controlConfigurationSHA256": {"type": "null"},
                  "completedAt": {"type": "null"}
                }
              }
            }
          },
          "designRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "snapshotRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "evidenceRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "closeoutRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "labSource": {
            "properties": {
              "status": {
                "const": "UNBOUND_DRAFT"
              },
              "commit": {
                "type": "null"
              },
              "tree": {
                "type": "null"
              },
              "freezeManifestSHA256": {
                "type": "null"
              }
            }
          },
          "runtime": {
            "properties": {
              "status": {
                "const": "UNBOUND_DRAFT"
              },
              "runtimeManifestSHA256": {
                "type": "null"
              }
            }
          },
          "beacon": {
            "properties": {
              "transportCABundleSHA256": {
                "$ref": "#/$defs/sha256"
              },
              "offlineTrustBundleSHA256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "freezeBlockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PUBLIC_DESIGN_FROZEN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "const": "corelm-crossmodel-livewiki-v3-design-v1"
          },
          "readyToFreeze": {
            "const": true
          },
          "countsTowardScientificVerdict": {
            "const": false
          },
          "developmentControls": {
            "properties": {
              "realDataE2EFreezeGate": {
                "properties": {
                  "status": {"const": "ARCHIVED_VERIFIED_BEFORE_FREEZE"},
                  "executionId": {
                    "type": "string",
                    "pattern": "^development-execution-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
                  },
                  "archiveReceiptSHA256": {"$ref": "#/$defs/sha256"},
                  "archivePublishedAt": {"$ref": "#/$defs/utcSecond"},
                  "archiveAttestedAt": {"$ref": "#/$defs/utcSecond"},
                  "releaseAttestationBundleSHA256": {"$ref": "#/$defs/sha256"},
                  "releaseAttestationOutputSHA256": {"$ref": "#/$defs/sha256"},
                  "reportSHA256": {"$ref": "#/$defs/sha256"},
                  "artifactSetSHA256": {"$ref": "#/$defs/sha256"},
                  "controlConfigurationSHA256": {"$ref": "#/$defs/sha256"},
                  "completedAt": {"$ref": "#/$defs/utcSecond"}
                }
              }
            }
          },
          "designRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "snapshotRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "evidenceRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "closeoutRelease": {
            "properties": {
              "signingKeyFingerprint": {
                "type": "string",
                "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
              },
              "signingPublicKeySHA256": {"$ref": "#/$defs/sha256"}
            }
          },
          "labSource": {
            "properties": {
              "status": {
                "const": "FROZEN_BOUND"
              },
              "commit": {
                "$ref": "#/$defs/gitObject"
              },
              "tree": {
                "$ref": "#/$defs/gitObject"
              },
              "freezeManifestSHA256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "runtime": {
            "properties": {
              "status": {
                "const": "FROZEN_BOUND"
              },
              "runtimeManifestSHA256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "beacon": {
            "properties": {
              "transportCABundleSHA256": {
                "$ref": "#/$defs/sha256"
              },
              "offlineTrustBundleSHA256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "freezeBlockers": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "utcSecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "developmentControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "dataset",
        "allowedEntryPoints",
        "realPretrainedModelsRequired",
        "realCorpusBytesRequired",
        "syntheticInputsForbidden",
        "futureCorpusUsed",
        "nistUsed",
        "scientificAttemptStateCreated",
        "scientificResultRootUsed",
        "countsTowardScientificVerdict",
        "usedForCandidateSelectionOrTuning",
        "configurationChangesAfterOutcome",
        "unitFixtureBoundary",
        "realDataE2EFreezeGate"
      ],
      "properties": {
        "status": {"const": "NON_SCIENTIFIC_PRE_FREEZE_ONLY"},
        "dataset": {
          "const": {
            "datasetId": "UniversalDependencies/UD_English-PUD:r2.18:test",
            "repository": "UniversalDependencies/UD_English-PUD",
            "revision": "e173a1be1b442faf34e7d5a502189ad5d9d1e197",
            "tree": "50f2ebe00ff016d2dca93f9bf6ee51c5f8493fde",
            "releaseTag": "r2.18",
            "split": "test",
            "splitPurpose": "upstream test split reused only as a non-scientific development control; it is not a blind scientific test result",
            "file": "en_pud-ud-test.conllu",
            "format": "CoNLL-U",
            "bytes": 1386858,
            "sha256": "c80584f2bc2b31d5bada78a1136f9feec7ac49e5e18898db02dea434b5b8f0aa",
            "rows": 1000,
            "rowExtraction": "exactly one '# text = ' value from each LF-delimited CoNLL-U sentence block; prefix removed; text otherwise unchanged",
            "joinedTextBytes": 112419,
            "joinedTextSHA256": "69dd039b37979f91b165981e92ae578067ecdf0db69bbee0a431c9f337c0f8ea",
            "license": "CC-BY-SA-3.0",
            "manifestPath": "v3/development-corpus.draft.json",
            "manifestBytes": 1985,
            "manifestSHA256": "b18149b73be0bb2510759c8ca567c4ab0a9f04f7960eb4c6a44b6eedfbda9634"
          }
        },
        "allowedEntryPoints": {
          "const": [
            {
              "path": "v3/run_real_e2e_control.py",
              "control": "producer-vtl5-independent-replay",
              "candidateCodecInvoked": true,
              "candidateMetricsComputed": true
            }
          ]
        },
        "realPretrainedModelsRequired": {"const": true},
        "realCorpusBytesRequired": {"const": true},
        "syntheticInputsForbidden": {"const": true},
        "futureCorpusUsed": {"const": false},
        "nistUsed": {"const": false},
        "scientificAttemptStateCreated": {"const": false},
        "scientificResultRootUsed": {"const": false},
        "countsTowardScientificVerdict": {"const": false},
        "usedForCandidateSelectionOrTuning": {"const": false},
        "configurationChangesAfterOutcome": {
          "const": "NEW_SUITE_AND_COMPLETE_TIMELINE_REQUIRED"
        },
        "unitFixtureBoundary": {
          "const": "ISOLATED_NON_RESULT_PROTOCOL_TESTS_ONLY"
        },
        "realDataE2EFreezeGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "reportSchemaVersion",
            "reportFileName",
            "completeNoLaterThan",
            "serverTimestampedArchiveRequired",
            "archiveTag",
            "archiveRequiredAssetRoles",
            "status",
            "executionId",
            "archiveReceiptSHA256",
            "archivePublishedAt",
            "archiveAttestedAt",
            "releaseAttestationBundleSHA256",
            "releaseAttestationOutputSHA256",
            "reportSHA256",
            "artifactSetSHA256",
            "controlConfigurationSHA256",
            "completedAt"
          ],
          "properties": {
            "required": {"const": true},
            "reportSchemaVersion": {
              "const": "corelm-crossmodel-v3-real-e2e-development-report-v1"
            },
            "reportFileName": {"const": "development-control-report.json"},
            "completeNoLaterThan": {"const": "2026-08-15T00:00:00Z"},
            "serverTimestampedArchiveRequired": {"const": true},
            "archiveTag": {
              "const": "corelm-crossmodel-livewiki-v3-development-control"
            },
            "archiveRequiredAssetRoles": {
              "const": [
                "development-control-report",
                "development-control-artifacts",
                "sha256-manifest"
              ]
            },
            "status": {
              "enum": ["UNBOUND_DRAFT", "ARCHIVED_VERIFIED_BEFORE_FREEZE"]
            },
            "executionId": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^development-execution-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
                },
                {"type": "null"}
              ]
            },
            "archiveReceiptSHA256": {
              "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
            },
            "archivePublishedAt": {
              "oneOf": [{"$ref": "#/$defs/utcSecond"}, {"type": "null"}]
            },
            "archiveAttestedAt": {
              "oneOf": [{"$ref": "#/$defs/utcSecond"}, {"type": "null"}]
            },
            "releaseAttestationBundleSHA256": {
              "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
            },
            "releaseAttestationOutputSHA256": {
              "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
            },
            "reportSHA256": {
              "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
            },
            "artifactSetSHA256": {
              "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
            },
            "controlConfigurationSHA256": {
              "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
            },
            "completedAt": {
              "oneOf": [{"$ref": "#/$defs/utcSecond"}, {"type": "null"}]
            }
          }
        }
      }
    },
    "releasePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "publishNoLaterThan",
        "sourcePolicy",
        "serverTimestampRequired",
        "immutableReleaseRequired",
        "signedAnnotatedTagRequired",
        "signatureType",
        "signingKeyFingerprint",
        "signingPublicKeySHA256"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "publishNoLaterThan": {
          "$ref": "#/$defs/utcSecond"
        },
        "sourcePolicy": {
          "const": "EXACT_FROZEN_DESIGN_LAB_SOURCE_COMMIT_TREE"
        },
        "serverTimestampRequired": {
          "const": true
        },
        "immutableReleaseRequired": {
          "const": true
        },
        "signedAnnotatedTagRequired": {
          "const": true
        },
        "signatureType": {
          "const": "SSH"
        },
        "signingKeyFingerprint": {
          "type": ["string", "null"]
        },
        "signingPublicKeySHA256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "closeoutReleasePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "publishNoLaterThan",
        "sourcePolicy",
        "serverTimestampRequired",
        "immutableReleaseRequired",
        "signedAnnotatedTagRequired",
        "signatureType",
        "signingKeyFingerprint",
        "signingPublicKeySHA256"
      ],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "publishNoLaterThan": {"$ref": "#/$defs/utcSecond"},
        "sourcePolicy": {
          "const": "EXACT_FROZEN_DESIGN_LAB_SOURCE_COMMIT_TREE"
        },
        "serverTimestampRequired": {"const": true},
        "immutableReleaseRequired": {"const": true},
        "signedAnnotatedTagRequired": {"const": true},
        "signatureType": {"const": "SSH"},
        "signingKeyFingerprint": {"type": ["string", "null"]},
        "signingPublicKeySHA256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "futureCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects",
        "creationInterval",
        "snapshotPolicy",
        "firstCrawlNotBefore",
        "secondCrawlNotBefore",
        "minimumEligibleRevisionsPerProject",
        "pagesSelectedPerCorpus",
        "tokenization",
        "prospectiveHoldout",
        "license",
        "attributionLedgerRequired"
      ],
      "properties": {
        "projects": {
          "const": [
            "de.wikipedia.org",
            "en.wikipedia.org",
            "fr.wikipedia.org"
          ]
        },
        "creationInterval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startInclusive",
            "endExclusive"
          ],
          "properties": {
            "startInclusive": {
              "$ref": "#/$defs/utcSecond"
            },
            "endExclusive": {
              "$ref": "#/$defs/utcSecond"
            }
          }
        },
        "snapshotPolicy": {
          "type": "string",
          "minLength": 1
        },
        "firstCrawlNotBefore": {
          "$ref": "#/$defs/utcSecond"
        },
        "secondCrawlNotBefore": {
          "$ref": "#/$defs/utcSecond"
        },
        "minimumEligibleRevisionsPerProject": {
          "type": "integer",
          "minimum": 64
        },
        "pagesSelectedPerCorpus": {
          "const": 16
        },
        "tokenization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "unicodeNormalization",
            "utf8",
            "addSpecialTokens",
            "minimumTokensUnderEveryRegisteredTokenizer"
          ],
          "properties": {
            "input": {
              "type": "string",
              "minLength": 1
            },
            "unicodeNormalization": {
              "const": "none"
            },
            "utf8": {
              "const": "strict"
            },
            "addSpecialTokens": {
              "const": false
            },
            "minimumTokensUnderEveryRegisteredTokenizer": {
              "type": "integer",
              "minimum": 512
            }
          }
        },
        "prospectiveHoldout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claimType",
            "operatorBlindnessClaimed",
            "futureCorpusUnavailableAtDesignFreeze",
            "exactSelectionUnavailableUntilTargetPulse",
            "preAttemptModelInferenceOnEligibleRecords",
            "metricOrCandidateTuningUsingEligibleRecords",
            "permittedPreAttemptProcessing",
            "behavioralComplianceCryptographicallyAttested"
          ],
          "properties": {
            "claimType": {"const": "PROSPECTIVE_BEACON_SELECTED_HOLDOUT"},
            "operatorBlindnessClaimed": {"const": false},
            "futureCorpusUnavailableAtDesignFreeze": {"const": true},
            "exactSelectionUnavailableUntilTargetPulse": {"const": true},
            "preAttemptModelInferenceOnEligibleRecords": {
              "const": "FORBIDDEN_FROM_FIRST_COLLECTION_THROUGH_ATTEMPT_MARKER"
            },
            "metricOrCandidateTuningUsingEligibleRecords": {"const": "FORBIDDEN"},
            "permittedPreAttemptProcessing": {
              "const": [
                "collection",
                "eligibility-validation",
                "canonicalization",
                "tokenization-for-minimum-length-only",
                "hashing",
                "packaging"
              ]
            },
            "behavioralComplianceCryptographicallyAttested": {"const": false}
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attributionLedgerRequired": {
          "const": true
        }
      }
    },
    "reschedulePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionCheckpoint",
        "requiredStateAtCheckpoint",
        "actionIfNotReady",
        "newSuiteIdRequired",
        "minimumLeadTimesMustBePreserved",
        "moveTogether"
      ],
      "properties": {
        "decisionCheckpoint": {"const": "2026-08-14T12:00:00Z"},
        "requiredStateAtCheckpoint": {
          "const": "all pre-publication P0 inputs complete; author self-verification recorded; exact-commit CI observed through direct verified TLS and archived with no GitHub response signature and offline structural-consistency-only verification; only immutable design publication remains"
        },
        "actionIfNotReady": {"const": "DO_NOT_FREEZE_OR_PUBLISH_THIS_SUITE"},
        "newSuiteIdRequired": {"const": true},
        "minimumLeadTimesMustBePreserved": {"const": true},
        "moveTogether": {
          "const": [
            "designRelease.publishNoLaterThan",
            "futureCorpus.creationInterval",
            "futureCorpus.firstCrawlNotBefore",
            "futureCorpus.secondCrawlNotBefore",
            "snapshotRelease.publishNoLaterThan",
            "beacon.targetTimestamp",
            "beacon.targetUnixMilliseconds",
            "beacon.pulseEndpoint",
            "execution.oneShotNotBefore",
            "execution.hardDeadline",
            "evidenceRelease.publishNoLaterThan",
            "closeoutRelease.publishNoLaterThan"
          ]
        }
      }
    },
    "fileCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "codecSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "requiredFiles"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
